{%- liquid
  assign whatsapp_phone = app.metafields.whatsio.phone.value
  assign whatsapp_message = app.metafields.whatsio.message.value
  assign whatsapp_position = app.metafields.whatsio.position.value | default: 'right'
-%}

{%- if whatsapp_phone != blank -%}
  {%- capture whatsapp_url -%}https://wa.me/{{ whatsapp_phone }}?text={{ whatsapp_message | url_encode }}{%- endcapture -%}
  <a
    class="whatsio-button whatsio-button--{{ whatsapp_position | escape }}"
    href="{{ whatsapp_url | escape }}"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="{{ 'whatsio.open_chat' | t | escape }}"
  >
    <svg
      class="whatsio-button__icon"
      viewBox="0 0 32 32"
      aria-hidden="true"
      focusable="false"
    >
      <path fill="currentColor" d="M16.04 3C8.86 3 3.02 8.8 3.02 15.94c0 2.28.6 4.5 1.74 6.45L3 29l6.82-1.78a13.08 13.08 0 0 0 6.21 1.58h.01c7.18 0 13.02-5.8 13.02-12.94C29.06 8.8 23.22 3 16.04 3Zm0 23.62h-.01c-1.91 0-3.79-.51-5.43-1.47l-.39-.23-4.05 1.06 1.08-3.92-.25-.4a10.69 10.69 0 0 1-1.66-5.72c0-5.94 4.81-10.76 10.72-10.76 5.9 0 10.71 4.82 10.71 10.76 0 5.87-4.81 10.68-10.72 10.68Zm5.88-8.03c-.32-.16-1.91-.94-2.21-1.05-.3-.11-.51-.16-.73.16-.21.32-.83 1.05-1.02 1.26-.19.21-.38.24-.7.08-.32-.16-1.36-.5-2.59-1.59a9.67 9.67 0 0 1-1.79-2.22c-.19-.32-.02-.5.14-.66.15-.14.32-.37.49-.56.16-.19.21-.32.32-.53.11-.21.05-.4-.03-.56-.08-.16-.73-1.74-1-2.39-.26-.63-.53-.54-.73-.55h-.62c-.22 0-.57.08-.86.4-.3.32-1.13 1.1-1.13 2.68 0 1.58 1.16 3.11 1.32 3.32.16.21 2.28 3.46 5.52 4.85.77.33 1.37.53 1.84.68.77.24 1.47.21 2.03.13.62-.09 1.91-.77 2.18-1.52.27-.74.27-1.37.19-1.5-.08-.14-.3-.22-.62-.38Z" />
    </svg>
  </a>
{%- endif -%}

{% schema %}
{
  "name": "WhatsApp chat",
  "target": "body",
  "stylesheet": "whatsio.css",
  "settings": []
}
{% endschema %}
